+    // MARK: - Trackpad scrolling and two finger swipes
+
+    override func scrollWheel(with event: NSEvent) {
+        let point = convert(event.locationInWindow, from: nil)
+        guard bounds.contains(point), virtualMachine != nil else { return }
+
+        // Physical finger movement, independent of the "natural scrolling" setting.
+        var dx = event.scrollingDeltaX
+        var dy = event.scrollingDeltaY
+        if event.isDirectionInvertedFromDevice {
+            dx = -dx
+            dy = -dy
+        }
+        // A classic wheel reports whole lines; a trackpad reports points.
+        if !event.hasPreciseScrollingDeltas {
+            dx *= 14
+            dy *= 14
+        }
+
+        let isFirstEvent = !scrollGestureActive
+            && (event.phase == .began || (event.phase == [] && event.momentumPhase == []))
+        if isFirstEvent {
+            scrollGestureActive = true
+            scrollTouchPoint = point
+            scrollGestureStart = point
+            currentTouchSwipeAim = hitTestEdge(at: point)
+            window?.makeFirstResponder(self)
+            if !sendTouchEvent(phase: 0, localPoint: scrollTouchPoint, timestamp: event.timestamp) {
+                scrollGestureActive = false
+                return
+            }
+        }
+        guard scrollGestureActive else { return }
+
+        scrollTouchPoint.x += dx
+        scrollTouchPoint.y += dy
+        scrollTouchPoint.x = max(0, min(bounds.width, scrollTouchPoint.x))
+        scrollTouchPoint.y = max(0, min(bounds.height, scrollTouchPoint.y))
+        _ = sendTouchEvent(phase: 1, localPoint: scrollTouchPoint, timestamp: event.timestamp)
+
+        let isLastEvent = event.phase == .ended || event.phase == .cancelled
+            || (event.phase == [] && event.momentumPhase == [])
+        if isLastEvent {
+            _ = sendTouchEvent(phase: 3, localPoint: scrollTouchPoint, timestamp: event.timestamp)
+            scrollGestureActive = false
+            currentTouchSwipeAim = 0
+        }
+    }
+
