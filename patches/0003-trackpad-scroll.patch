+    // MARK: - Trackpad scrolling and two finger swipes
+
+    /// Two finger trackpad input: the pointer stays a pointer, the trackpad
+    /// becomes the touch. Scroll deltas are replayed as ONE continuous touch
+    /// drag (momentum included), so scrolling moves the guest's content and a
+    /// swipe that starts at an edge performs the matching system gesture.
+    private var scrollGestureActive = false
+    private var scrollTouchPoint: NSPoint = .zero
+    private var scrollEndTask: Task<Void, Never>?
+
+    /// A gesture ends this long after the last delta. Trackpads that report
+    /// deltas without phases would otherwise turn every delta into its own
+    /// touch-down/up pair, which the guest reads as a series of taps and
+    /// ignores until the middle of the swipe.
+    private static let scrollGestureIdleNanos: UInt64 = 140_000_000
+
+    override func scrollWheel(with event: NSEvent) {
+        let point = convert(event.locationInWindow, from: nil)
+        guard bounds.contains(point), virtualMachine != nil else { return }
+
+        // Finger travel. Vertical follows the system's scrolling setting,
+        // horizontal is flipped: a phone page moves the other way than a Mac
+        // scroll view does under the same two fingers.
+        let inverted: CGFloat = event.isDirectionInvertedFromDevice ? -1 : 1
+        var dx = -inverted * event.scrollingDeltaX
+        var dy = inverted * event.scrollingDeltaY
+
+        // Trackpads report points, a classic wheel reports whole lines, and a
+        // phone screen is far smaller than a trackpad: both get scaled up so a
+        // normal swipe crosses the screen.
+        let gain: CGFloat = event.hasPreciseScrollingDeltas ? 1.9 : 22
+        dx *= gain
+        dy *= gain
+
+        if !scrollGestureActive {
+            // Ignore the tail of a flick whose gesture already finished.
+            if event.phase == [], event.momentumPhase != [] { return }
+            scrollGestureActive = true
+            scrollTouchPoint = point
+            currentTouchSwipeAim = hitTestEdge(at: point)
+            window?.makeFirstResponder(self)
+            if !sendTouchEvent(phase: 0, localPoint: scrollTouchPoint, timestamp: event.timestamp) {
+                scrollGestureActive = false
+                return
+            }
+        }
+
+        scrollTouchPoint.x = max(0, min(bounds.width, scrollTouchPoint.x + dx))
+        scrollTouchPoint.y = max(0, min(bounds.height, scrollTouchPoint.y + dy))
+        _ = sendTouchEvent(phase: 1, localPoint: scrollTouchPoint, timestamp: event.timestamp)
+
+        if event.phase == .ended || event.phase == .cancelled {
+            finishScrollGesture()
+        } else {
+            scheduleScrollGestureEnd()
+        }
+    }
+
+    private func scheduleScrollGestureEnd() {
+        scrollEndTask?.cancel()
+        scrollEndTask = Task { @MainActor [weak self] in
+            try? await Task.sleep(nanoseconds: Self.scrollGestureIdleNanos)
+            guard !Task.isCancelled else { return }
+            self?.finishScrollGesture()
+        }
+    }
+
+    private func finishScrollGesture() {
+        scrollEndTask?.cancel()
+        scrollEndTask = nil
+        guard scrollGestureActive else { return }
+        scrollGestureActive = false
+        _ = sendTouchEvent(phase: 3, localPoint: scrollTouchPoint,
+                           timestamp: ProcessInfo.processInfo.systemUptime)
+        currentTouchSwipeAim = 0
+    }
+
